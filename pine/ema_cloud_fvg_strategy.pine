//@version=5
// ============================================================================
// EMA Cloud + 5m/15m FVG Tap Strategy — designed for NQ futures (long only)
//
// Concept:
//   * The EMA cloud (fast 20 / medium-slow 50) is calculated on the CHART
//     timeframe. Switch the chart from 5m to 15m and the cloud re-adjusts
//     automatically (on a 5m chart it is the 5m EMA cloud, on 15m the 15m
//     cloud, etc.).
//   * Fair Value Gaps are ALWAYS detected on the 5-minute and 15-minute
//     timeframes — never combined with the chart TF. On a 5m chart you still
//     get both 5m and 15m gaps; same on a 15m chart.
//   * A long entry requires ALL of:
//       1. Bullish cloud (fast EMA above slow EMA)
//       2. Price taps INTO the cloud (bar low reaches the fast EMA) while
//          holding above the slow EMA (cloud not broken)
//       3. The tap aligns with (overlaps) an active bullish FVG from the
//          5m and/or 15m timeframe
//
// Run this on a 1m, 3m, 5m, or 15m chart. Above 15m the FVG engines are
// disabled (a warning is shown) because 5m/15m gaps can't be built from
// larger bars.
// ============================================================================

strategy("EMA Cloud + 5m/15m FVG Tap [NQ, Long]",
     shorttitle = "Cloud+FVG NQ",
     overlay = true,
     initial_capital = 25000,
     default_qty_type = strategy.fixed,
     default_qty_value = 2,   // >= 2 contracts required for the scale-out exit mode
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 1.4,
     slippage = 1,
     max_boxes_count = 500)

// ----------------------------------------------------------------------------
// Inputs
// ----------------------------------------------------------------------------
grpCloud = "EMA Cloud (chart timeframe — re-adjusts when you switch TF)"
fastLen            = input.int(20,  "Fast EMA length",        minval = 1, group = grpCloud)
slowLen            = input.int(50,  "Medium/Slow EMA length", minval = 1, group = grpCloud)
needCloseAboveFast = input.bool(true, "Tap bar must close back above the fast EMA", group = grpCloud)
useTrendEma        = input.bool(false, "Extra slow trend-EMA filter (close must be above it)", group = grpCloud)
trendLen           = input.int(200, "Trend EMA length", minval = 1, group = grpCloud)

grpFvg = "Fair Value Gaps (fixed 5m & 15m — independent of chart TF)"
use5        = input.bool(true,  "Use 5-minute FVGs",  group = grpFvg)
use15       = input.bool(true,  "Use 15-minute FVGs", group = grpFvg)
fvgMode     = input.string("Either TF", "Tap must align with FVG on", options = ["Either TF", "Both TFs"], group = grpFvg)
minGapTicks = input.int(0,  "Minimum gap size (ticks)",        minval = 0,             group = grpFvg)
maxZones    = input.int(12, "Max active zones kept per TF",    minval = 1, maxval = 40, group = grpFvg)
showBoxes   = input.bool(true, "Draw FVG boxes", group = grpFvg)
firstTapOnly = input.bool(false, "Only trade the FIRST tap of each zone", group = grpFvg)
useCloudFvg  = input.bool(true, "FVG zone must overlap the EMA cloud (true confluence)", group = grpFvg)

grpFilt = "Entry quality filters (all optional — toggle one at a time)"
useSlope    = input.bool(false, "Cloud slope: both EMAs must be rising", group = grpFilt)
slopeBars   = input.int(3,      "└ Slope lookback (bars)", minval = 1, group = grpFilt)
useThick    = input.bool(false, "Min cloud thickness (trend strength)", group = grpFilt)
thickAtr    = input.float(0.3,  "└ Thickness (ATR-14 multiple)", minval = 0.0, step = 0.05, group = grpFilt)
useCandle   = input.bool(false, "Rejection candle: close in top % of bar range", group = grpFilt)
closePosPct = input.float(60,   "└ Close position (% of range)", minval = 0, maxval = 100, group = grpFilt)
useVol      = input.bool(false, "Tap bar volume above average", group = grpFilt)
volMult     = input.float(1.2,  "└ Volume multiple of 20-bar average", minval = 0.1, step = 0.1, group = grpFilt)
useHtfTrend = input.bool(false, "1-hour trend filter: close above 1h EMA", group = grpFilt)
htfTrendLen = input.int(50,     "└ 1h EMA length", minval = 1, group = grpFilt)
useVwap     = input.bool(false, "Price must be above session VWAP", group = grpFilt)
useAdx      = input.bool(false, "ADX trend-strength filter (skip range days)", group = grpFilt)
adxMin      = input.float(20,   "└ Min ADX(14)", minval = 5, step = 1, group = grpFilt)
useStruct   = input.bool(true,  "Fresh structure: recent break of a swing high", group = grpFilt)
structLen   = input.int(20,     "└ Swing high lookback (bars)", minval = 2, group = grpFilt)
structWithin = input.int(10,    "└ Break must be within last N bars", minval = 1, group = grpFilt)
useSweep    = input.bool(false, "Liquidity sweep: wick below a prior low, reclaimed", group = grpFilt)
sweepLen    = input.int(10,     "└ Prior low lookback (bars)", minval = 2, group = grpFilt)
sweepWithin = input.int(3,      "└ Sweep within last N bars", minval = 1, group = grpFilt)
useDayOpen  = input.bool(false, "Longs only above the daily open", group = grpFilt)
usePbReset  = input.bool(true,  "One trade per pullback (re-arm above fast EMA)", group = grpFilt)
pbResetBars = input.int(2,      "└ Closes above fast EMA needed to re-arm", minval = 1, group = grpFilt)
maxStretch  = input.float(0.0,  "Max distance of close above fast EMA (ATR mult, 0 = off)", minval = 0.0, step = 0.1, group = grpFilt)

grpRisk = "Risk management"
stopBasis    = input.string("FVG bottom", "Stop placement", options = ["FVG bottom", "Slow EMA", "Lowest of both"], group = grpRisk)
stopBufTicks = input.int(8,    "Stop buffer (ticks)",       minval = 0,               group = grpRisk)
exitStyle    = input.string("Single target", "Exit style", options = ["Single target", "Scale-out (2 targets)"], group = grpRisk)
rMult        = input.float(2.0, "Single target: take-profit (R multiple)", minval = 0.1, step = 0.1, group = grpRisk)
tp1R         = input.float(0.75, "Scale-out: TP1 (R)", minval = 0.1, step = 0.05, group = grpRisk)
tp1Pct       = input.int(50,     "Scale-out: TP1 position %", minval = 10, maxval = 90, step = 10, group = grpRisk)
tp2R         = input.float(2.5,  "Scale-out: TP2 (R)", minval = 0.2, step = 0.1, group = grpRisk)
beAfterTp1   = input.bool(true,  "Scale-out: stop to breakeven after TP1 fills", group = grpRisk)
exitOnFlip   = input.bool(true, "Also exit if the cloud flips bearish", group = grpRisk)
useBE        = input.bool(false, "Move stop to breakeven", group = grpRisk)
beTrigger    = input.float(0.6,  "└ Breakeven trigger (R)", minval = 0.1, step = 0.1, group = grpRisk)
beOffTicks   = input.int(2,      "└ Breakeven offset (ticks past entry)", minval = 0, group = grpRisk)
maxPerDay    = input.int(0,      "Max trades per day (0 = unlimited)", minval = 0, group = grpRisk)
maxLossDay   = input.int(0,      "Stop trading after N losses in a day (0 = off)", minval = 0, group = grpRisk)
cooldownBars = input.int(0,      "Cooldown bars between entries (0 = off)", minval = 0, group = grpRisk)
useSwingCap  = input.bool(false, "Cap single target at recent swing high", group = grpRisk)
swingLen     = input.int(20,     "└ Swing high lookback (bars)", minval = 2, group = grpRisk)
minRR        = input.float(0.5,  "└ Min reward:risk to still take the trade", minval = 0.1, step = 0.1, group = grpRisk)

grpSess    = "Session filter"
useSession = input.bool(false, "Limit entries to a session", group = grpSess)
sess       = input.session("0830-1500", "Session (exchange time)", group = grpSess)
useLunchSkip = input.bool(false, "Skip lunch chop", group = grpSess)
lunchSess    = input.session("1030-1230", "Lunch session (exchange time; CME = Chicago)", group = grpSess)

// ----------------------------------------------------------------------------
// EMA cloud — chart timeframe, so it adapts when you change timeframes
// ----------------------------------------------------------------------------
emaFast  = ta.ema(close, fastLen)
emaSlow  = ta.ema(close, slowLen)
emaTrend = ta.ema(close, trendLen)

bullCloud = emaFast > emaSlow

pFast = plot(emaFast, "Fast EMA (20)", color = color.new(color.teal,   0))
pSlow = plot(emaSlow, "Slow EMA (50)", color = color.new(color.orange, 0))
fill(pFast, pSlow, color = bullCloud ? color.new(color.teal, 80) : color.new(color.red, 80), title = "EMA Cloud")
plot(useTrendEma ? emaTrend : na, "Trend EMA", color = color.new(color.gray, 40))

// ----------------------------------------------------------------------------
// Higher-timeframe data (non-repainting: only CLOSED 5m / 15m bars are used)
// ----------------------------------------------------------------------------
chartSec = timeframe.in_seconds(timeframe.period)
ok5  = use5  and chartSec <= timeframe.in_seconds("5")
ok15 = use15 and chartSec <= timeframe.in_seconds("15")

f_htf(tf) =>
    request.security(syminfo.tickerid, tf, [high, low, time], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

[h5,  l5,  t5]  = f_htf("5")
[h15, l15, t15] = f_htf("15")

// ----------------------------------------------------------------------------
// FVG tracker. Each call keeps its own zone arrays (one instance per TF).
// A bullish FVG forms on the HTF when the low of bar N is above the high of
// bar N-2 (classic 3-candle imbalance). The zone stays active until price
// closes below its bottom (fully filled / invalidated).
// Returns: [tap bar overlaps an active zone, lowest bottom of overlapped zones]
// ----------------------------------------------------------------------------
f_trackFvg(float hi, float lo, int tm, bool enabled, bool firstOnly, color zoneColor) =>
    var tops    = array.new_float()
    var bottoms = array.new_float()
    var touched = array.new_bool()    // has this zone been tapped before?
    var zBoxes  = array.new_box()
    var confHi  = array.new_float()   // last 3 CONFIRMED HTF highs
    var confLo  = array.new_float()   // last 3 CONFIRMED HTF lows

    if enabled
        newHtfBar = not na(tm[1]) and tm != tm[1]
        if newHtfBar
            array.push(confHi, hi[1])
            array.push(confLo, lo[1])
            if array.size(confHi) > 3
                array.shift(confHi)
                array.shift(confLo)
            if array.size(confHi) == 3
                gapBottom = array.get(confHi, 0)   // high of the oldest bar
                gapTop    = array.get(confLo, 2)   // low of the newest bar
                if not na(gapBottom) and not na(gapTop) and gapTop - gapBottom > minGapTicks * syminfo.mintick
                    array.push(tops, gapTop)
                    array.push(bottoms, gapBottom)
                    array.push(touched, false)
                    array.push(zBoxes, showBoxes
                         ? box.new(bar_index, gapTop, bar_index, gapBottom,
                             border_color = color.new(zoneColor, 40),
                             bgcolor      = color.new(zoneColor, 85),
                             extend       = extend.right)
                         : box(na))
                    if array.size(tops) > maxZones
                        box.delete(array.shift(zBoxes))
                        array.shift(tops)
                        array.shift(bottoms)
                        array.shift(touched)
        // drop zones that price has closed below (gap filled / invalidated)
        if array.size(tops) > 0
            for i = array.size(tops) - 1 to 0
                if close < array.get(bottoms, i)
                    box.delete(array.get(zBoxes, i))
                    array.remove(zBoxes, i)
                    array.remove(tops, i)
                    array.remove(bottoms, i)
                    array.remove(touched, i)

    inZone = false
    float zoneBottom = na
    if enabled and array.size(tops) > 0
        cTop = math.max(emaFast, emaSlow)
        cBot = math.min(emaFast, emaSlow)
        for i = 0 to array.size(tops) - 1
            zTop = array.get(tops, i)
            zBot = array.get(bottoms, i)
            if low <= zTop and high >= zBot
                cloudHit = not useCloudFvg or (zTop >= cBot and zBot <= cTop)
                if cloudHit and (not firstOnly or not array.get(touched, i))
                    inZone := true
                    zoneBottom := na(zoneBottom) ? zBot : math.min(zoneBottom, zBot)
                array.set(touched, i, true)
    [inZone, zoneBottom]

[fvg5,  bot5]  = f_trackFvg(h5,  l5,  t5,  ok5,  firstTapOnly, color.blue)
[fvg15, bot15] = f_trackFvg(h15, l15, t15, ok15, firstTapOnly, color.purple)

anyFvgTf   = ok5 or ok15
alignBoth  = anyFvgTf and (not ok5 or fvg5) and (not ok15 or fvg15)
alignAny   = fvg5 or fvg15
fvgAligned = fvgMode == "Both TFs" ? alignBoth : alignAny

float fvgBottom = na
if fvg5
    fvgBottom := bot5
if fvg15
    fvgBottom := na(fvgBottom) ? bot15 : math.min(fvgBottom, bot15)

// ----------------------------------------------------------------------------
// Entry quality filters (each one is a no-op unless enabled)
// ----------------------------------------------------------------------------
atr14  = ta.atr(14)
volSma = ta.sma(volume, 20)
htfEma = request.security(syminfo.tickerid, "60", ta.ema(close, htfTrendLen)[1], lookahead = barmerge.lookahead_on)

vwapVal   = ta.vwap(hlc3)
swingHigh = ta.highest(high, swingLen)

barRange  = high - low
slopeOk   = not useSlope    or (emaFast > emaFast[slopeBars] and emaSlow > emaSlow[slopeBars])
thickOk   = not useThick    or (emaFast - emaSlow) >= thickAtr * atr14
candleOk  = not useCandle   or (barRange > 0 and (close - low) / barRange >= closePosPct / 100)
volOk     = not useVol      or volume > volSma * volMult
htfOk     = not useHtfTrend or close > htfEma
vwapOk    = not useVwap     or close > vwapVal
stretchOk = maxStretch == 0 or close - emaFast <= maxStretch * atr14

// structure / sweep / regime confluences
[diPlus, diMinus, adxVal] = ta.dmi(14, 14)
hhPrev    = ta.highest(high, structLen)[1]
bosBars   = ta.barssince(high > hhPrev)
priorLow  = ta.lowest(low, sweepLen)[1]
sweepBars = ta.barssince(low < priorLow and close > priorLow)
dayOpen   = request.security(syminfo.tickerid, "D", open, lookahead = barmerge.lookahead_on)

adxOk     = not useAdx     or adxVal >= adxMin
structOk  = not useStruct  or (not na(bosBars) and bosBars <= structWithin)
sweepOk   = not useSweep   or (not na(sweepBars) and sweepBars <= sweepWithin)
dayOpenOk = not useDayOpen or close > dayOpen

// one-trade-per-pullback state: after a signal, price must first leave the
// cloud again (close above the fast EMA for N bars) before a new tap counts
var bool pbArmed  = true
var int aboveFast = 0
aboveFast := close > emaFast ? aboveFast + 1 : 0
if not pbArmed and aboveFast >= pbResetBars
    pbArmed := true
pbOk = not usePbReset or pbArmed

plot(useVwap ? vwapVal : na, "Session VWAP", color = color.new(color.yellow, 30))

// ----------------------------------------------------------------------------
// Trade pacing: daily cap and cooldown between entries
// ----------------------------------------------------------------------------
var int tradesToday  = 0
var int lossesToday  = 0
var int lastEntryBar = na
if ta.change(time("D")) != 0
    tradesToday := 0
    lossesToday := 0
lossDelta = ta.change(strategy.losstrades)
if lossDelta > 0
    lossesToday += lossDelta
dayOk      = maxPerDay == 0 or tradesToday < maxPerDay
lossOk     = maxLossDay == 0 or lossesToday < maxLossDay
cooldownOk = cooldownBars == 0 or na(lastEntryBar) or bar_index - lastEntryBar > cooldownBars

// ----------------------------------------------------------------------------
// Entry logic: bullish cloud + tap into the cloud + FVG alignment + filters
// ----------------------------------------------------------------------------
inSession = not useSession or not na(time(timeframe.period, sess))
lunchOk   = not useLunchSkip or na(time(timeframe.period, lunchSess))

cloudTap = bullCloud
     and low <= emaFast                                  // price reached into the cloud
     and close > emaSlow                                 // but the cloud held
     and (not needCloseAboveFast or close > emaFast)     // optional rejection close

longCond = cloudTap
     and fvgAligned
     and anyFvgTf
     and inSession
     and (not useTrendEma or close > emaTrend)
     and slopeOk and thickOk and candleOk and volOk and htfOk and vwapOk and stretchOk
     and adxOk and structOk and sweepOk and dayOpenOk and pbOk and lunchOk
     and dayOk and lossOk and cooldownOk

// a fired signal consumes this pullback until price re-arms above the fast EMA
if longCond
    pbArmed := false

scaleOut = exitStyle == "Scale-out (2 targets)"

var float trStop   = na
var float trTp     = na
var float trTp1    = na
var bool  beDone   = false
var bool  tp1Done  = false
var float entryQty = na
var float maxQtySeen = 0.0

if longCond and strategy.position_size == 0
    float baseStop = switch stopBasis
        "FVG bottom" => na(fvgBottom) ? emaSlow : fvgBottom
        "Slow EMA"   => emaSlow
        => math.min(na(fvgBottom) ? emaSlow : fvgBottom, emaSlow)
    stopPrice = baseStop - stopBufTicks * syminfo.mintick
    riskPts   = close - stopPrice
    // single-target mode: optionally cap the target at the recent swing high
    // (targets just under structure get hit far more often than fixed R targets
    // placed beyond it); skip the trade if the capped reward:risk is too small
    float tpSingle = close + rMult * riskPts
    if useSwingCap and not scaleOut
        tpSingle := math.min(tpSingle, swingHigh)
    rrOk = scaleOut or not useSwingCap or tpSingle - close >= minRR * riskPts
    if riskPts > 0 and rrOk
        trStop  := stopPrice
        trTp1   := close + tp1R * riskPts
        trTp    := scaleOut ? close + tp2R * riskPts : tpSingle
        beDone  := false
        tp1Done := false
        tradesToday  += 1
        lastEntryBar := bar_index
        strategy.entry("Long", strategy.long)
        if scaleOut
            strategy.exit("TP1", from_entry = "Long", qty_percent = tp1Pct, stop = trStop, limit = trTp1)
            strategy.exit("TP2", from_entry = "Long", stop = trStop, limit = trTp)
        else
            strategy.exit("Exit", from_entry = "Long", stop = trStop, limit = trTp)

// track the filled entry size so a partial TP1 fill can be detected
if strategy.position_size > 0
    if na(entryQty)
        entryQty := strategy.position_size
    maxQtySeen := math.max(maxQtySeen, strategy.position_size)
else
    entryQty := na

// scale-out: once TP1 has filled, move the runner's stop to breakeven
if scaleOut and not tp1Done and strategy.position_size > 0 and not na(entryQty) and strategy.position_size < entryQty
    tp1Done := true
    if beAfterTp1
        trStop := strategy.position_avg_price + beOffTicks * syminfo.mintick
    strategy.exit("TP2", from_entry = "Long", stop = trStop, limit = trTp)

// optional: move stop to breakeven once price has travelled beTrigger * R in our favor
if useBE and not beDone and strategy.position_size > 0
    avgPrice = strategy.position_avg_price
    risk0    = avgPrice - trStop
    if risk0 > 0 and high >= avgPrice + beTrigger * risk0
        trStop := avgPrice + beOffTicks * syminfo.mintick
        beDone := true
        if scaleOut
            if not tp1Done
                strategy.exit("TP1", from_entry = "Long", qty_percent = tp1Pct, stop = trStop, limit = trTp1)
            strategy.exit("TP2", from_entry = "Long", stop = trStop, limit = trTp)
        else
            strategy.exit("Exit", from_entry = "Long", stop = trStop, limit = trTp)

if exitOnFlip and strategy.position_size > 0 and not bullCloud
    strategy.close("Long", comment = "Cloud flipped bearish")

plotshape(longCond and strategy.position_size == 0, "Buy signal", shape.triangleup,
     location.belowbar, color.new(color.green, 0), size = size.small, text = "TAP+FVG")

alertcondition(longCond, "Cloud tap + FVG alignment", "Bullish EMA cloud tap aligned with 5m/15m FVG on {{ticker}}")

// ----------------------------------------------------------------------------
// Warn if the chart TF is too high for the 5m/15m FVG engines
// ----------------------------------------------------------------------------
var table warnT = table.new(position.top_right, 1, 2)
if barstate.islast and not anyFvgTf
    table.cell(warnT, 0, 0, "Chart TF too high for 5m/15m FVGs — use a 15m chart or lower",
         text_color = color.red, bgcolor = color.new(color.yellow, 70))
if barstate.islast and scaleOut and maxQtySeen > 0 and maxQtySeen < 2
    table.cell(warnT, 0, 1, "Scale-out needs order size >= 2 contracts (Properties tab)",
         text_color = color.red, bgcolor = color.new(color.yellow, 70))
