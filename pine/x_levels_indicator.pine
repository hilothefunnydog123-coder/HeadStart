//@version=5
indicator(" X Levels", overlay=true, max_lines_count=300, max_labels_count=300)

//--------------------------------------------------
// Inputs
//--------------------------------------------------
alignPts      = input.float(5.0, "Body-edge alignment max pts", step=0.25)
minGapPts     = input.float(1.0, "Minimum 1m FVG gap pts", step=0.25)
minImpulsePts = input.float(0.0, "Min displacement from level", step=0.25)

tagHtf        = input.bool(true, "Tag HTF FVG confluence")
requireHtf    = input.bool(false, "Only show levels with HTF confluence")
requireInside = input.bool(false, "Require inside HTF FVG")
nearPts       = input.float(5.0, "Near HTF FVG pts", step=0.25)

use5m  = input.bool(true, "Use 5m")
use15m = input.bool(true, "Use 15m")
use1h  = input.bool(false, "Use 1h")
use4h  = input.bool(false, "Use 4h")

showBullish = input.bool(true, "Show bullish XVX")
showBearish = input.bool(true, "Show bearish XVX")

maxLevels = input.int(80, "Max visible XVX levels", minval=5, maxval=300)
maxFvgs   = input.int(200, "Max stored HTF FVGs per TF", minval=20, maxval=500)

dupPts      = input.float(3.0, "Duplicate level tolerance pts", step=0.25)
labelOffset = input.int(20, "Label offset bars", minval=1, maxval=200)

deleteOnTap   = input.bool(false, "Delete after tap")
deleteInvalid = input.bool(false, "Delete invalidated levels")
invalidPts    = input.float(5.0, "Invalid close through by pts", step=0.25)

//--------------------------------------------------
// HTF FVG storage
//--------------------------------------------------
var float[] fvg5Lo = array.new_float()
var float[] fvg5Hi = array.new_float()
var int[]   fvg5Dir = array.new_int()

var float[] fvg15Lo = array.new_float()
var float[] fvg15Hi = array.new_float()
var int[]   fvg15Dir = array.new_int()

var float[] fvg1hLo = array.new_float()
var float[] fvg1hHi = array.new_float()
var int[]   fvg1hDir = array.new_int()

var float[] fvg4hLo = array.new_float()
var float[] fvg4hHi = array.new_float()
var int[]   fvg4hDir = array.new_int()

var float[] hi5Hist = array.new_float()
var float[] lo5Hist = array.new_float()
var float cur5Hi = na
var float cur5Lo = na

var float[] hi15Hist = array.new_float()
var float[] lo15Hist = array.new_float()
var float cur15Hi = na
var float cur15Lo = na

var float[] hi1hHist = array.new_float()
var float[] lo1hHist = array.new_float()
var float cur1hHi = na
var float cur1hLo = na

var float[] hi4hHist = array.new_float()
var float[] lo4hHist = array.new_float()
var float cur4hHi = na
var float cur4hLo = na

//--------------------------------------------------
// Helpers
//--------------------------------------------------
f_trim_fvg(_loArr, _hiArr, _dirArr) =>
    if array.size(_loArr) > maxFvgs
        array.shift(_loArr)
        array.shift(_hiArr)
        array.shift(_dirArr)

f_add_fvg(_loArr, _hiArr, _dirArr, _lo, _hi, _dir) =>
    array.push(_loArr, _lo)
    array.push(_hiArr, _hi)
    array.push(_dirArr, _dir)
    f_trim_fvg(_loArr, _hiArr, _dirArr)

f_clean_fvgs(_loArr, _hiArr, _dirArr) =>
    if array.size(_loArr) > 0
        for i = array.size(_loArr) - 1 to 0
            lo = array.get(_loArr, i)
            hi = array.get(_hiArr, i)
            dir = array.get(_dirArr, i)

            inversed = dir == 1 ? close < lo : close > hi

            if inversed
                array.remove(_loArr, i)
                array.remove(_hiArr, i)
                array.remove(_dirArr, i)

f_match_fvg(_price, _dir, _loArr, _hiArr, _dirArr) =>
    hit = false

    if array.size(_loArr) > 0
        for i = 0 to array.size(_loArr) - 1
            lo = array.get(_loArr, i)
            hi = array.get(_hiArr, i)
            d  = array.get(_dirArr, i)

            inside = _price >= lo and _price <= hi
            near   = inside or math.abs(_price - lo) <= nearPts or math.abs(_price - hi) <= nearPts
            valid  = requireInside ? inside : near

            if d == _dir and valid
                hit := true

    hit

//--------------------------------------------------
// Build HTF FVG memory
//--------------------------------------------------
new5 = ta.change(time("5")) != 0

if na(cur5Hi)
    cur5Hi := high
    cur5Lo := low
else if new5
    array.push(hi5Hist, cur5Hi)
    array.push(lo5Hist, cur5Lo)

    if array.size(hi5Hist) > 10
        array.shift(hi5Hist)
        array.shift(lo5Hist)

    if array.size(hi5Hist) >= 3
        s = array.size(hi5Hist)
        c0Hi = array.get(hi5Hist, s - 3)
        c0Lo = array.get(lo5Hist, s - 3)
        c2Hi = array.get(hi5Hist, s - 1)
        c2Lo = array.get(lo5Hist, s - 1)

        if c2Lo > c0Hi
            f_add_fvg(fvg5Lo, fvg5Hi, fvg5Dir, c0Hi, c2Lo, 1)

        if c2Hi < c0Lo
            f_add_fvg(fvg5Lo, fvg5Hi, fvg5Dir, c2Hi, c0Lo, -1)

    cur5Hi := high
    cur5Lo := low
else
    cur5Hi := math.max(cur5Hi, high)
    cur5Lo := math.min(cur5Lo, low)

new15 = ta.change(time("15")) != 0

if na(cur15Hi)
    cur15Hi := high
    cur15Lo := low
else if new15
    array.push(hi15Hist, cur15Hi)
    array.push(lo15Hist, cur15Lo)

    if array.size(hi15Hist) > 10
        array.shift(hi15Hist)
        array.shift(lo15Hist)

    if array.size(hi15Hist) >= 3
        s = array.size(hi15Hist)
        c0Hi = array.get(hi15Hist, s - 3)
        c0Lo = array.get(lo15Hist, s - 3)
        c2Hi = array.get(hi15Hist, s - 1)
        c2Lo = array.get(lo15Hist, s - 1)

        if c2Lo > c0Hi
            f_add_fvg(fvg15Lo, fvg15Hi, fvg15Dir, c0Hi, c2Lo, 1)

        if c2Hi < c0Lo
            f_add_fvg(fvg15Lo, fvg15Hi, fvg15Dir, c2Hi, c0Lo, -1)

    cur15Hi := high
    cur15Lo := low
else
    cur15Hi := math.max(cur15Hi, high)
    cur15Lo := math.min(cur15Lo, low)

new1h = ta.change(time("60")) != 0

if na(cur1hHi)
    cur1hHi := high
    cur1hLo := low
else if new1h
    array.push(hi1hHist, cur1hHi)
    array.push(lo1hHist, cur1hLo)

    if array.size(hi1hHist) > 10
        array.shift(hi1hHist)
        array.shift(lo1hHist)

    if array.size(hi1hHist) >= 3
        s = array.size(hi1hHist)
        c0Hi = array.get(hi1hHist, s - 3)
        c0Lo = array.get(lo1hHist, s - 3)
        c2Hi = array.get(hi1hHist, s - 1)
        c2Lo = array.get(lo1hHist, s - 1)

        if c2Lo > c0Hi
            f_add_fvg(fvg1hLo, fvg1hHi, fvg1hDir, c0Hi, c2Lo, 1)

        if c2Hi < c0Lo
            f_add_fvg(fvg1hLo, fvg1hHi, fvg1hDir, c2Hi, c0Lo, -1)

    cur1hHi := high
    cur1hLo := low
else
    cur1hHi := math.max(cur1hHi, high)
    cur1hLo := math.min(cur1hLo, low)

new4h = ta.change(time("240")) != 0

if na(cur4hHi)
    cur4hHi := high
    cur4hLo := low
else if new4h
    array.push(hi4hHist, cur4hHi)
    array.push(lo4hHist, cur4hLo)

    if array.size(hi4hHist) > 10
        array.shift(hi4hHist)
        array.shift(lo4hHist)

    if array.size(hi4hHist) >= 3
        s = array.size(hi4hHist)
        c0Hi = array.get(hi4hHist, s - 3)
        c0Lo = array.get(lo4hHist, s - 3)
        c2Hi = array.get(hi4hHist, s - 1)
        c2Lo = array.get(lo4hHist, s - 1)

        if c2Lo > c0Hi
            f_add_fvg(fvg4hLo, fvg4hHi, fvg4hDir, c0Hi, c2Lo, 1)

        if c2Hi < c0Lo
            f_add_fvg(fvg4hLo, fvg4hHi, fvg4hDir, c2Hi, c0Lo, -1)

    cur4hHi := high
    cur4hLo := low
else
    cur4hHi := math.max(cur4hHi, high)
    cur4hLo := math.min(cur4hLo, low)

// Clean inversed HTF FVGs
f_clean_fvgs(fvg5Lo, fvg5Hi, fvg5Dir)
f_clean_fvgs(fvg15Lo, fvg15Hi, fvg15Dir)
f_clean_fvgs(fvg1hLo, fvg1hHi, fvg1hDir)
f_clean_fvgs(fvg4hLo, fvg4hHi, fvg4hDir)

//--------------------------------------------------
// 1m XVX structure
//--------------------------------------------------
bullCminus1 = math.min(open[3], close[3])
bullC0      = math.min(open[2], close[2])
bullAlign   = math.abs(bullCminus1 - bullC0)
bullLevel   = (bullCminus1 + bullC0) / 2.0
bullFvg     = low > high[2]
bullGap     = low - high[2]
bullImpulse = close - bullLevel

bullRaw =
     barstate.isconfirmed and
     showBullish and
     bullFvg and
     bullGap >= minGapPts and
     bullAlign <= alignPts and
     bullImpulse >= minImpulsePts

bearCminus1 = math.max(open[3], close[3])
bearC0      = math.max(open[2], close[2])
bearAlign   = math.abs(bearCminus1 - bearC0)
bearLevel   = (bearCminus1 + bearC0) / 2.0
bearFvg     = high < low[2]
bearGap     = low[2] - high
bearImpulse = bearLevel - close

bearRaw =
     barstate.isconfirmed and
     showBearish and
     bearFvg and
     bearGap >= minGapPts and
     bearAlign <= alignPts and
     bearImpulse >= minImpulsePts

//--------------------------------------------------
// HTF matching
//--------------------------------------------------
bull5Match  = use5m  and f_match_fvg(bullLevel, 1, fvg5Lo, fvg5Hi, fvg5Dir)
bull15Match = use15m and f_match_fvg(bullLevel, 1, fvg15Lo, fvg15Hi, fvg15Dir)
bull1hMatch = use1h  and f_match_fvg(bullLevel, 1, fvg1hLo, fvg1hHi, fvg1hDir)
bull4hMatch = use4h  and f_match_fvg(bullLevel, 1, fvg4hLo, fvg4hHi, fvg4hDir)

bear5Match  = use5m  and f_match_fvg(bearLevel, -1, fvg5Lo, fvg5Hi, fvg5Dir)
bear15Match = use15m and f_match_fvg(bearLevel, -1, fvg15Lo, fvg15Hi, fvg15Dir)
bear1hMatch = use1h  and f_match_fvg(bearLevel, -1, fvg1hLo, fvg1hHi, fvg1hDir)
bear4hMatch = use4h  and f_match_fvg(bearLevel, -1, fvg4hLo, fvg4hHi, fvg4hDir)

bullTag = ""
bullTag := bull5Match ? "5m" : bullTag
bullTag := bull15Match ? (bullTag == "" ? "15m" : bullTag + "+15m") : bullTag
bullTag := bull1hMatch ? (bullTag == "" ? "1h" : bullTag + "+1h") : bullTag
bullTag := bull4hMatch ? (bullTag == "" ? "4h" : bullTag + "+4h") : bullTag

bearTag = ""
bearTag := bear5Match ? "5m" : bearTag
bearTag := bear15Match ? (bearTag == "" ? "15m" : bearTag + "+15m") : bearTag
bearTag := bear1hMatch ? (bearTag == "" ? "1h" : bearTag + "+1h") : bearTag
bearTag := bear4hMatch ? (bearTag == "" ? "4h" : bearTag + "+4h") : bearTag

bullGrade = bull5Match and bull15Match ? "A+" : bull5Match or bull15Match ? "A" : bullTag != "" ? "B" : ""
bearGrade = bear5Match and bear15Match ? "A+" : bear5Match or bear15Match ? "A" : bearTag != "" ? "B" : ""

bullValid = bullRaw and (not requireHtf or bullTag != "")
bearValid = bearRaw and (not requireHtf or bearTag != "")

//--------------------------------------------------
// Level storage
//--------------------------------------------------
var line[]  lvlLines  = array.new_line()
var label[] lvlLabels = array.new_label()
var float[] lvls      = array.new_float()
var int[]   dirs      = array.new_int()
var int[]   bornBars  = array.new_int()

f_duplicate(_level, _dir) =>
    dup = false

    if array.size(lvls) > 0
        for i = 0 to array.size(lvls) - 1
            if array.get(dirs, i) == _dir and math.abs(array.get(lvls, i) - _level) <= dupPts
                dup := true

    dup

f_trim_levels() =>
    if array.size(lvls) >= maxLevels
        line.delete(array.shift(lvlLines))
        label.delete(array.shift(lvlLabels))
        array.shift(lvls)
        array.shift(dirs)
        array.shift(bornBars)

f_add_level(_level, _dir, _tag, _grade) =>
    if not f_duplicate(_level, _dir)
        f_trim_levels()

        txt = tagHtf and _tag != "" ? "1m x lvl / HT " + _tag + " / " + _grade : "1m x lvl"

        col = _grade == "A+" ? color.aqua : _grade == "A" ? color.new(color.aqua, 15) : color.new(color.aqua, 35)

        l = line.new(
             bar_index - 3,
             _level,
             bar_index + 1,
             _level,
             extend=extend.right,
             color=col,
             width=_grade == "A+" ? 2 : 1
         )

        lb = label.new(
             bar_index + labelOffset,
             _level,
             txt,
             style=label.style_label_center,
             textcolor=color.white,
             color=color.new(color.blue, 0),
             size=size.tiny
         )

        array.push(lvlLines, l)
        array.push(lvlLabels, lb)
        array.push(lvls, _level)
        array.push(dirs, _dir)
        array.push(bornBars, bar_index)

//--------------------------------------------------
// Add levels
//--------------------------------------------------
if bullValid
    f_add_level(bullLevel, 1, bullTag, bullGrade)

if bearValid
    f_add_level(bearLevel, -1, bearTag, bearGrade)

//--------------------------------------------------
// Cleanup
//--------------------------------------------------
if array.size(lvls) > 0
    for i = array.size(lvls) - 1 to 0
        lvl  = array.get(lvls, i)
        dir  = array.get(dirs, i)
        born = array.get(bornBars, i)

        canCheck = bar_index > born
        tapped   = canCheck and low <= lvl and high >= lvl
        invalid  = canCheck and (dir == 1 ? close < lvl - invalidPts : close > lvl + invalidPts)

        if (deleteOnTap and tapped) or (deleteInvalid and invalid)
            line.delete(array.get(lvlLines, i))
            label.delete(array.get(lvlLabels, i))

            array.remove(lvlLines, i)
            array.remove(lvlLabels, i)
            array.remove(lvls, i)
            array.remove(dirs, i)
            array.remove(bornBars, i)
