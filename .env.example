# Server-only credential used by netlify/functions/traffic.ts.
GOOGLE_ROUTES_API_KEY=

# Absolute production origin used by native background refresh, for example:
# VITE_DEPARTURE_API_BASE_URL=https://departure.example.com
VITE_DEPARTURE_API_BASE_URL=

# Optional additional browser origins for cross-origin self-hosted clients.
# Capacitor localhost origins and the current Netlify host are allowed automatically.
TRAFFIC_ALLOWED_ORIGINS=
